.menu .contents .account-content
    .account
        max-width 360px
        margin 0 auto
        display flex
        flex-direction column
        gap 12px

    .account-hint
        font-size 14px
        line-height 1.5
        opacity 0.85
        margin 0

    .account-card
        display flex
        align-items center
        gap 12px
        padding 12px
        border-radius 12px
        background rgba(255, 255, 255, 0.06)

    .account-avatar
        width 44px
        height 44px
        border-radius 50%
        background #c30e3a
        display flex
        align-items center
        justify-content center
        font-size 20px
        font-weight 700
        overflow hidden
        flex-shrink 0

        img
            width 100%
            height 100%
            object-fit cover

    .account-name
        font-size 17px
        font-weight 700

    .account-status
        font-size 13px
        opacity 0.75

        &.is-saved
            color #d5ff95
            opacity 1

        &.is-error
            color #ff6a7c
            opacity 1

    .account-google
        display flex
        align-items center
        justify-content center
        gap 10px
        height 46px
        border-radius 10px
        border none
        background #ffffff
        color #1f1f1f
        font-size 16px
        font-weight 600
        cursor pointer

        &:hover
            background #f1f1f1

    .account-or
        display flex
        align-items center
        gap 10px
        font-size 13px
        opacity 0.6

        &::before, &::after
            content ''
            flex 1
            height 1px
            background rgba(255, 255, 255, 0.3)

    .account-form
        display flex
        flex-direction column
        gap 8px

        input
            height 42px
            padding 0 12px
            border-radius 8px
            border 1px solid rgba(255, 255, 255, 0.25)
            background rgba(0, 0, 0, 0.3)
            color #ffffff
            font-size 16px
            outline none

            &:focus
                border-color #ffceca

    .account-button
        height 44px
        width 100%

    .account-links
        display flex
        justify-content space-between

        button
            background none
            border none
            color #ffceca
            font-size 14px
            cursor pointer
            padding 0
            text-decoration underline

    .account-message
        min-height 20px
        font-size 14px
        color #ffd27a
        text-align center
