.menu .contents .environment-content
    .environment-hint
        text-align center
        font-size 14px
        opacity 0.75
        margin 0 0 14px

    .js-environment
        max-width 420px
        margin 0 auto
        display flex
        flex-direction column
        gap 16px

    .environment-label
        display flex
        justify-content space-between
        align-items baseline
        font-size 17px
        font-weight 700
        margin-bottom 8px

    .environment-lock
        font-size 12px
        font-weight 400
        opacity 0.65

    .environment-options
        display grid
        grid-template-columns repeat(auto-fill, minmax(62px, 1fr))
        gap 8px

    .environment-option
        display flex
        flex-direction column
        align-items center
        gap 4px
        padding 10px 4px 8px
        border-radius 12px
        border 1px solid rgba(255, 255, 255, 0.14)
        background rgba(255, 255, 255, 0.05)
        color #ffffff
        cursor pointer
        transition background 0.15s, border-color 0.15s, transform 0.1s

        .icon
            font-size 22px
            line-height 1

        .label
            font-size 13px

        html:not(.is-mode-touch) &:hover
            background rgba(255, 255, 255, 0.1)

        &:active
            transform scale(0.96)

        &.is-active
            border-color #ffd27a
            background rgba(255, 210, 122, 0.16)
            box-shadow 0 0 0 1px #ffd27a inset

        &.is-auto .icon
            font-size 19px
