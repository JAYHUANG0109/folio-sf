// A Christmas letter in the style of an old acceptance letter: an aged parchment envelope addressed in green ink,
// sealed with red wax, opening into a parchment letter with an ink crest and letterhead (sources/Game/Letter.js).
// Everything sits on a 3D stage that tilts with the pointer and lifts toward you on hover.
ink = #3a2412
wine = #7d1420

.love-letter
    position fixed
    inset 0
    z-index 60
    display grid
    place-items center
    padding 16px
    opacity 0
    pointer-events none
    transition opacity 0.8s ease
    font-family "IM Fell English", "Noto Serif TC", serif
    color ink
    overflow hidden
    perspective 1100px
    perspective-origin 50% 45%

    &.is-visible
        opacity 1
        pointer-events auto

    .ll-backdrop
        position absolute
        inset 0
        background radial-gradient(ellipse 80% 70% at 50% 45%, rgba(40, 22, 14, 0.78), rgba(8, 8, 10, 0.95))
        backdrop-filter blur(6px) saturate(0.7)

    .ll-bokeh
        position absolute
        inset 0
        pointer-events none
        span
            position absolute
            width var(--s)
            height var(--s)
            margin calc(var(--s) * -0.5)
            border-radius 50%
            background radial-gradient(circle, var(--c) 0%, transparent 68%)
            opacity 0.15
            filter blur(6px)
            animation ll-glow 8s ease-in-out infinite alternate

    .ll-snow
        position absolute
        inset 0
        pointer-events none
        span
            position absolute
            top -10px
            width var(--s)
            height var(--s)
            border-radius 50%
            background #fff
            filter blur(0.6px)
            animation-name ll-snowfall
            animation-timing-function linear
            animation-iteration-count infinite

    // gold dust trailing the pointer over the letter
    .ll-dust
        position fixed
        z-index 70
        width 5px
        height 5px
        margin -2.5px
        border-radius 50%
        pointer-events none
        background #ffe9a8
        box-shadow 0 0 8px 3px rgba(255, 210, 120, 0.8)
        animation ll-dust 1.2s ease-out forwards

    /* ---------- 3D stage ---------- */
    .ll-stage
        grid-area 1 / 1
        position relative
        z-index 2
        display grid
        place-items center
        transform-style preserve-3d
        transform translateY(var(--float, 0px)) scale(var(--fit, 1)) translateZ(var(--lift, 0px)) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg))
        transition --fit 0.3s

    .ll-glare
        position absolute
        inset 0
        border-radius inherit
        pointer-events none
        z-index 8
        background radial-gradient(circle at var(--gx, 50%) var(--gy, 30%), rgba(255, 250, 230, 0.45), rgba(255, 240, 200, 0.08) 30%, transparent 58%)
        mix-blend-mode soft-light
        transform translateZ(30px)

    /* ---------- the envelope: parchment, green ink address, red wax ---------- */
    .ll-envelope
        grid-area 1 / 1
        position relative
        z-index 2
        transform-style preserve-3d
        width 88vw
        max-width 440px
        aspect-ratio 1.55
        border none
        padding 0
        cursor pointer
        border-radius 3px
        background radial-gradient(ellipse at 20% 15%, rgba(255, 250, 230, 0.7), transparent 45%), radial-gradient(ellipse at 85% 90%, rgba(120, 80, 30, 0.35), transparent 50%), linear-gradient(160deg, #efe0bf, #d9c294 60%, #c7ab78)
        box-shadow 0 30px 70px rgba(0, 0, 0, 0.6), inset 0 0 40px rgba(110, 70, 25, 0.45), inset 0 0 0 1px rgba(110, 70, 25, 0.3)
        transform translateY(24px) scale(0.94)
        transition transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1.1), opacity 0.6s ease 0.55s
        outline none
        &:focus-visible
            box-shadow 0 30px 70px rgba(0, 0, 0, 0.6), 0 0 0 3px #e7c873

    .ll-back
        position absolute
        inset 0
        border-radius 3px
        background linear-gradient(160deg, #cdb382, #a98a55)
        transform translateZ(-6px)

    .ll-pocket
        position absolute
        inset 0
        border-radius 3px
        background linear-gradient(to top right, rgba(140, 100, 50, 0.16) 50%, transparent 50.3%) left / 50.2% 100% no-repeat, linear-gradient(to top left, rgba(140, 100, 50, 0.12) 50%, transparent 50.3%) right / 50.2% 100% no-repeat

    .ll-flap
        position absolute
        left 0
        right 0
        top 0
        height 54%
        background linear-gradient(180deg, #ead9b3, #d6bd8c)
        clip-path polygon(0 0, 100% 0, 50% 100%)
        transform-origin top center
        transition transform 0.8s ease
        filter drop-shadow(0 4px 4px rgba(60, 35, 10, 0.35))
        z-index 2
        backface-visibility hidden

    .ll-address
        position absolute
        left 10%
        bottom 16%
        z-index 1
        display flex
        flex-direction column
        align-items flex-start
        text-align left
        font-family "Pinyon Script", "IM Fell English", "Noto Serif TC", serif
        font-size 17px
        line-height 1.35
        color #1f4a33
        transform translateZ(8px) rotate(-2deg)
        em
            font-style normal
            font-family "Pinyon Script", "Noto Serif TC", serif
            font-size 30px
            margin-bottom 4px

    // red sealing wax, irregular, with an embossed J
    .ll-seal
        position absolute
        left 50%
        top 54%
        width 74px
        height 70px
        margin -35px 0 0 -37px
        border-radius 52% 48% 55% 45% / 47% 55% 45% 53%
        display grid
        place-items center
        background radial-gradient(circle at 36% 30%, #d8434c, #9b1b24 45%, #6a0c14 85%)
        box-shadow 0 5px 12px rgba(0, 0, 0, 0.5), inset 0 -4px 6px rgba(40, 0, 5, 0.6), inset 0 3px 5px rgba(255, 160, 160, 0.35)
        z-index 3
        transform translateZ(26px)
        transition transform 0.6s ease, opacity 0.45s ease
        span
            width 48px
            height 48px
            border-radius 50%
            display grid
            place-items center
            font-family "Great Vibes", serif
            font-size 36px
            color #6a0c14
            text-shadow 0 1px 0 rgba(255, 170, 170, 0.45), 0 -1px 0 rgba(30, 0, 0, 0.6)
            box-shadow inset 0 0 0 2px rgba(80, 5, 12, 0.5), inset 0 0 0 5px rgba(255, 120, 120, 0.12)

    .ll-holly-seal
        position absolute
        left calc(50% - 4px)
        top calc(54% + 10px)
        width 60px
        z-index 4
        transform translateZ(40px) rotate(-18deg)
        filter drop-shadow(0 2px 3px rgba(0, 0, 0, 0.4))
        transition opacity 0.4s ease

    .ll-hint
        position absolute
        left 0
        right 0
        bottom 16%
        z-index 3
        text-align center
        font-size 14px
        color rgba(241, 220, 156, 0.8)
        letter-spacing 0.3em
        transition opacity 0.4s ease

    &.is-visible .ll-envelope
        transform translateY(0) scale(1)

    /* ---------- the letter: aged parchment ---------- */
    .ll-paper
        grid-area 1 / 1
        position relative
        z-index 3
        transform-style preserve-3d
        width 92vw
        max-width 540px
        padding 30px 48px 24px
        border-radius 2px
        text-align center
        background radial-gradient(ellipse 70% 55% at 50% 45%, rgba(255, 248, 225, 0.85), transparent 70%), radial-gradient(circle at 12% 88%, rgba(150, 100, 40, 0.22), transparent 22%), radial-gradient(circle at 88% 14%, rgba(150, 100, 40, 0.18), transparent 20%), radial-gradient(ellipse at 50% 50%, transparent 55%, rgba(120, 75, 25, 0.45) 100%), linear-gradient(175deg, #efdfba, #e2cb9c 55%, #d6bb87)
        box-shadow 0 1px 0 #d4bb88, 0 2px 0 #cbb07c, 0 3px 0 #c1a46f, 0 40px 80px rgba(0, 0, 0, 0.6), 0 12px 24px rgba(0, 0, 0, 0.3)
        transform translateY(150px) translateZ(-130px) rotateX(-60deg) scale(0.8)
        opacity 0
        pointer-events none
        transition transform 1.35s cubic-bezier(0.16, 0.9, 0.25, 1.05) 0.55s, opacity 0.5s ease 0.55s

        // a soft horizontal fold across the middle
        &::before
            content ''
            position absolute
            left 0
            right 0
            top 50%
            height 2px
            background linear-gradient(90deg, transparent, rgba(110, 70, 25, 0.18) 20%, rgba(255, 250, 235, 0.4) 50%, rgba(110, 70, 25, 0.18) 80%, transparent)
            pointer-events none
        // paper grain
        &::after
            content ''
            position absolute
            inset 0
            pointer-events none
            opacity 0.5
            background-image radial-gradient(rgba(90, 60, 20, 0.12) 0.8px, transparent 0.8px), radial-gradient(rgba(255, 255, 255, 0.25) 0.8px, transparent 0.8px)
            background-size 4px 4px, 7px 7px
            background-position 0 0, 2px 3px

        p, h2
            margin 0
            position relative
            z-index 1

    // a ring stain and blotches
    .ll-stains
        position absolute
        inset 0
        pointer-events none
        background radial-gradient(ellipse at 25% 30%, rgba(160, 110, 50, 0.1), transparent 18%), radial-gradient(ellipse at 70% 55%, rgba(160, 110, 50, 0.08), transparent 15%)

    .ll-garland
        position absolute
        left 0
        top -14px
        width 100%
        height 70px
        z-index 2
        filter drop-shadow(0 3px 3px rgba(40, 30, 10, 0.3))
        transform translateZ(40px)

    .ll-bulb ellipse
        animation ll-twinkle 2.4s ease-in-out infinite
        animation-delay var(--d)
        filter drop-shadow(0 0 3px var(--c)) drop-shadow(0 0 6px var(--c))

    .ll-crest
        display block
        width 150px
        margin 34px auto 2px
        transform translateZ(34px)
        filter drop-shadow(0 1px 0 rgba(255, 250, 230, 0.5))

    .ll-office
        text-align center
        font-family "Cinzel", serif
        font-weight 500
        font-size 21px
        line-height 1.25
        letter-spacing 0.06em
        color ink
        transform translateZ(24px)
        span
            display block
        .ll-office-2
            font-size 17px
            margin-top 1px
        small
            font-family "Pinyon Script", serif
            font-size 22px
            letter-spacing 0
            margin 0 4px

    .ll-head
        text-align center
        font-family "Cinzel", serif
        font-size 12px
        letter-spacing 0.12em
        margin 4px 0 18px !important
        transform translateZ(18px)

    .ll-orders
        text-align center
        font-style italic
        font-size 12px
        line-height 1.4
        color rgba(58, 36, 18, 0.8)
        margin 3px auto 14px !important
        max-width 360px
        transform translateZ(14px)

    .ll-greeting
        font-family "Pinyon Script", "Noto Serif TC", serif
        font-size 30px
        line-height 1.1
        color wine
        margin-bottom 12px !important
        transform translateZ(22px)

    .ll-body
        transform translateZ(14px)
        p
            margin 0 0 10px !important
            font-family "Noto Serif TC", "IM Fell English", serif
            font-size 16px
            line-height 1.85
            letter-spacing 0.05em
            color #2f1d0f
        span
            display block
            white-space nowrap

    .ll-closing
        font-style italic
        font-size 16px
        margin-top 16px !important
        transform translateZ(16px)

    .ll-signature
        font-family "Great Vibes", "Noto Serif TC", serif
        font-size 34px
        line-height 1.1
        color wine
        margin 10px 0 4px !important
        transform translateZ(26px) rotate(-2deg)
        transform-origin center

    .ll-sigline
        font-family "IM Fell English", "Noto Serif TC", serif
        font-size 13px
        letter-spacing 0.04em
        color rgba(58, 36, 18, 0.85)
        transform translateZ(14px)

    .ll-holly-corner
        position absolute
        right 18px
        bottom 18px
        width 62px
        z-index 1
        transform translateZ(36px) rotate(10deg)

    .ll-close
        position relative
        z-index 1
        display block
        margin 14px auto 0
        padding 9px 30px
        border 1px solid rgba(110, 70, 25, 0.6)
        border-radius 2px
        cursor pointer
        font-family "Cinzel", "Noto Serif TC", serif
        font-size 14px
        letter-spacing 0.3em
        color wine
        background linear-gradient(180deg, rgba(255, 250, 235, 0.7), rgba(225, 205, 160, 0.7))
        transform translateZ(22px)
        transition box-shadow 0.25s ease, transform 0.25s ease
        &:hover
            transform translateZ(60px) scale(1.06)          // pops up toward you, inviting the click
            box-shadow 0 14px 26px rgba(125, 20, 32, 0.35)

    .ll-sparkles
        position absolute
        left 50%
        top 50%
        width 0
        height 0
        z-index 6
        transform-style preserve-3d
        pointer-events none
        span
            position absolute
            width var(--s)
            height var(--s)
            border-radius 50%
            box-shadow 0 0 10px 3px rgba(255, 220, 140, 0.95), 0 0 22px 6px rgba(255, 190, 90, 0.5)
            opacity 0
            animation ll-burst 2.2s cubic-bezier(0.1, 0.7, 0.3, 1) forwards

    /* ---------- opening ---------- */
    &.is-open
        .ll-envelope
            transform translateY(200px) translateZ(-260px) rotateX(25deg) scale(0.8)
            opacity 0
            pointer-events none
            transition transform 0.9s ease, opacity 0.3s ease 0.15s
        .ll-flap
            transform rotateX(180deg)
        .ll-seal
            transform translateZ(60px) scale(1.4) rotate(-25deg)
            opacity 0
        .ll-holly-seal
            opacity 0
        .ll-hint
            opacity 0
        .ll-paper
            transform translateY(0) translateZ(0) rotateX(0) scale(1)
            opacity 1
            pointer-events auto

@keyframes ll-snowfall
    0%
        transform translate(0, -10px)
    100%
        transform translate(var(--x), 105vh)

@keyframes ll-glow
    0%
        opacity 0.08
        transform scale(0.9)
    100%
        opacity 0.22
        transform scale(1.1)

@keyframes ll-twinkle
    0%, 100%
        opacity 1
    50%
        opacity 0.45

@keyframes ll-burst
    0%
        opacity 0
        transform translate3d(0, 0, 0) scale(0.4)
    12%
        opacity 1
    100%
        opacity 0
        transform translate3d(var(--dx), var(--dy), var(--z)) scale(1)

@keyframes ll-dust
    0%
        opacity 1
        transform translate(0, 0) scale(1)
    100%
        opacity 0
        transform translate(var(--dx), var(--dy)) scale(0.3)

@media (max-height: 820px)
    .love-letter
        .ll-crest
            width 124px
            margin-top 14px
        .ll-body p
            line-height 1.7
            margin-bottom 6px !important

@media (max-width: 480px)
    .love-letter
        .ll-paper
            padding 30px 22px 22px
        .ll-crest
            width 118px
        .ll-office
            font-size 17px
        .ll-body p
            font-size min(15px, 3.9vw)
            line-height 1.75
        .ll-envelope
            aspect-ratio 1.45
        .ll-address
            font-size 14px
            em
                font-size 22px

// touch screens: keep the tilt but render the card flat (no per-layer depth), so the text stays crisp
@media (hover: none)
    .love-letter
        .ll-paper *, .ll-envelope *
            transform none
        .ll-signature
            transform rotate(-3deg)
        .ll-holly-seal
            transform rotate(-18deg)
        .ll-holly-corner
            transform rotate(10deg)
        .ll-address
            transform rotate(-2deg)
