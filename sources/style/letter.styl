// A love letter: sealed envelope -> unfolding paper (see sources/Game/Letter.js)
.love-letter
    position fixed
    inset 0
    z-index 60
    display grid
    place-items center
    padding 16px
    opacity 0
    pointer-events none
    transition opacity 0.6s ease
    font-family "LXGW WenKai TC", "Noto Sans TC", "PingFang TC", serif
    overflow hidden

    &.is-visible
        opacity 1
        pointer-events auto

    .ll-backdrop
        position absolute
        inset 0
        background radial-gradient(ellipse at center, rgba(70, 20, 40, 0.55), rgba(20, 8, 20, 0.82))
        backdrop-filter blur(3px)

    .ll-heart
        position absolute
        bottom -40px
        color #ff8fae
        opacity 0
        pointer-events none
        animation ll-float 7s linear infinite
        z-index 1
        text-shadow 0 0 12px rgba(255, 120, 160, 0.7)

    // the envelope
    .ll-envelope
        grid-area 1 / 1
        position relative
        z-index 2
        width 86vw
        max-width 340px
        aspect-ratio 1.55
        border none
        padding 0
        cursor pointer
        background linear-gradient(160deg, #f6e3c8, #ead0ad)
        border-radius 10px
        box-shadow 0 24px 60px rgba(0, 0, 0, 0.45), inset 0 0 0 1px rgba(150, 100, 60, 0.25)
        transform translateY(20px) scale(0.92)
        transition transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1.2), opacity 0.6s ease 0.5s
        animation ll-bob 2.6s ease-in-out infinite
        outline none

        &:focus-visible
            box-shadow 0 24px 60px rgba(0, 0, 0, 0.45), 0 0 0 3px #ffd27a

    .ll-pocket
        position absolute
        inset 0
        border-radius 10px
        background linear-gradient(to top right, #e9c9a0 50%, transparent 50.5%) left / 50.2% 100% no-repeat, linear-gradient(to top left, #e3c095 50%, transparent 50.5%) right / 50.2% 100% no-repeat

    .ll-flap
        position absolute
        left 0
        right 0
        top 0
        height 58%
        background #efd6b4
        clip-path polygon(0 0, 100% 0, 50% 100%)
        transform-origin top center
        transition transform 0.7s ease
        filter drop-shadow(0 3px 3px rgba(120, 70, 40, 0.25))
        z-index 2

    .ll-seal
        position absolute
        left 50%
        top 58%
        width 54px
        height 54px
        margin -27px 0 0 -27px
        border-radius 50%
        display grid
        place-items center
        color #ffe0e6
        font-size 26px
        background radial-gradient(circle at 35% 30%, #e24a5e, #a3172d 70%)
        box-shadow 0 4px 10px rgba(90, 10, 25, 0.5), inset 0 0 0 4px rgba(255, 255, 255, 0.12)
        z-index 3
        transition transform 0.5s ease, opacity 0.4s ease

    .ll-to
        position absolute
        left 0
        right 0
        bottom 14%
        text-align center
        font-size 22px
        color #7a4a2c
        z-index 1

    .ll-hint
        position absolute
        left 0
        right 0
        bottom -38px
        text-align center
        font-size 15px
        color rgba(255, 240, 230, 0.85)
        letter-spacing 0.1em

    &.is-visible .ll-envelope
        transform translateY(0) scale(1)

    // the letter
    .ll-paper
        grid-area 1 / 1
        position relative
        width 92vw
        max-width 460px
        z-index 2
        max-height 86vh
        overflow auto
        padding 34px 34px 26px
        border-radius 6px
        color #4a2f22
        background radial-gradient(ellipse at 20% 0%, rgba(255, 200, 210, 0.35), transparent 60%), linear-gradient(170deg, #fffaf1, #f6e8d2)
        border 1px solid rgba(190, 140, 110, 0.3)
        box-shadow 0 30px 70px rgba(0, 0, 0, 0.5)
        transform translateY(60px) scaleY(0.05)
        transform-origin top center
        opacity 0
        pointer-events none
        transition transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.45s, opacity 0.4s ease 0.45s

        &::before
            content "♥"
            position absolute
            top 10px
            right 16px
            color #e0566c
            font-size 20px

        p
            margin 0

    .ll-greeting
        font-size 26px
        font-weight 700
        margin-bottom 14px !important
        color #8e1f35

    .ll-body p
        font-size 19px
        line-height 36px
        text-indent 2em

    .ll-signature
        margin-top 18px !important
        text-align right
        font-size 22px
        font-weight 700
        color #8e1f35

    .ll-close
        display block
        margin 22px auto 0
        padding 10px 26px
        border none
        border-radius 999px
        cursor pointer
        font inherit
        font-size 17px
        color #fff
        background linear-gradient(135deg, #e24a5e, #b51e3a)
        box-shadow 0 6px 16px rgba(170, 20, 50, 0.35)
        transition transform 0.2s ease

        &:hover
            transform translateY(-2px)

    &.is-open
        .ll-envelope
            animation none
            transform translateY(140px) scale(0.85)
            opacity 0
            pointer-events none
        .ll-flap
            transform rotateX(180deg)
        .ll-seal
            transform scale(0.4)
            opacity 0
        .ll-paper
            transform translateY(0) scaleY(1)
            opacity 1
            pointer-events auto

@keyframes ll-bob
    0%, 100%
        translate 0 0
    50%
        translate 0 -8px

@keyframes ll-float
    0%
        transform translateY(0) rotate(-10deg)
        opacity 0
    10%
        opacity 0.8
    100%
        transform translateY(-110vh) rotate(15deg)
        opacity 0

@media (max-width: 480px)
    .love-letter
        .ll-paper
            padding 28px 22px 22px
        .ll-body p
            font-size 17px
            line-height 32px
        .ll-greeting
            font-size 23px
