.menu .contents .options-content

    .content-inner
        display flex
        flex-direction column
        justify-content flex-start
        align-items center

    table
        border-spacing 0 10px

        td:first-child
            padding-right 40px
        
    .audio-toggle
        img
            width 29px
            height 27px

            &.audio-off
                display none
                
            &.audio-on
                display block

        html.is-audio-muted &
            img
                &.audio-on
                    display none

                &.audio-off
                    display block

    .button
        display flex
        align-items center
        justify-content center
        width 100%
// Music tab: now playing, genre cards, volume
.menu .contents .music-content
    .content-inner
        max-width 460px
        margin 0 auto

    .music-now
        display flex
        flex-direction column
        align-items center
        gap 4px
        margin 4px 0 22px 0
        padding 14px 16px
        border-radius 10px
        background linear-gradient(135deg, rgba(255, 210, 61, 0.16), rgba(255, 111, 174, 0.12))
        border 1px solid rgba(255, 210, 61, 0.35)

        .music-now-label
            font-size 13px
            letter-spacing 0.1em
            opacity 0.7

        .music-now-name
            font-size 22px

            small
                font-size 14px
                opacity 0.6
                margin-left 4px

    .music-section-label
        display block
        font-size 13px
        letter-spacing 0.1em
        opacity 0.6
        margin 0 0 8px 2px

    .music-genres
        display grid
        grid-template-columns repeat(2, minmax(0, 1fr))
        gap 10px
        margin-bottom 22px

        @media only screen and (max-width 520px)
            gap 8px

    .music-genre
        display flex
        flex-direction row
        align-items center
        gap 10px
        padding 10px 12px
        height auto
        min-height 58px
        cursor pointer
        border-radius 10px
        border 2px solid rgba(255, 255, 255, 0.12)
        background rgba(255, 255, 255, 0.05)
        color inherit
        font inherit
        text-align left
        transition background 0.2s, border-color 0.2s

        &:hover
            background rgba(255, 255, 255, 0.11)

        .music-genre-icon
            flex 0 0 auto
            display flex
            align-items center
            justify-content center
            width 36px
            height 36px
            border-radius 50%
            background rgba(255, 255, 255, 0.08)
            font-size 20px

        .music-genre-text
            display flex
            flex-direction column
            min-width 0
            flex 1 1 auto

        .music-genre-name
            font-size 16px
            line-height 1.2

        .music-genre-en
            font-size 11px
            opacity 0.55
            white-space nowrap
            overflow hidden
            text-overflow ellipsis

        .music-genre-bars
            display none
            align-items flex-end
            gap 2px
            height 16px

            i
                display block
                width 3px
                background #ffd23d
                border-radius 1px
                animation music-bars 0.9s ease-in-out infinite

                &:nth-child(2)
                    animation-delay -0.3s

                &:nth-child(3)
                    animation-delay -0.6s

        &.is-active
            border-color #ffd23d
            background rgba(255, 210, 61, 0.14)

            .music-genre-bars
                display flex

    .music-volume
        display block
        margin-bottom 14px

        input
            width 100%
            accent-color #ffd23d

    .music-hint
        margin 0
        opacity 0.55
        font-size 13px
        text-align center

@keyframes music-bars
    0%, 100%
        height 4px
    50%
        height 16px
