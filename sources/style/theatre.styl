// Napa castle theatre: the great hall fills the screen
.castle-theatre
    position fixed
    inset 0
    z-index 40
    display none
    background radial-gradient(ellipse at 50% 35%, #4a2f22 0%, #24140f 60%, #120a07 100%)
    color #fff2e8
    font-family "LXGW WenKai TC", "Noto Sans TC", "PingFang TC", sans-serif
    overflow hidden

    &::before
        // stone wall blocks
        content ''
        position absolute
        inset 0
        background-image linear-gradient(rgba(0, 0, 0, 0.25) 2px, transparent 2px), linear-gradient(90deg, rgba(0, 0, 0, 0.18) 2px, transparent 2px)
        background-size 120px 60px, 120px 60px
        opacity 0.5
        pointer-events none

    &.is-open
        display block
        animation ct-in 0.6s ease-out

    .ct-curtain
        position absolute
        top 0
        bottom 0
        width 9vw
        background repeating-linear-gradient(90deg, #6e0d1c 0 18px, #8f1426 18px 30px, #5a0a17 30px 44px)
        box-shadow 0 0 40px rgba(0, 0, 0, 0.6)
        z-index 1

        &.ct-left
            left 0
            border-right 4px solid #c9a227

        &.ct-right
            right 0
            border-left 4px solid #c9a227

    .ct-inner
        position relative
        z-index 2
        height 100%
        margin 0 9vw
        display flex
        flex-direction column
        align-items center
        padding 16px 20px
        gap 12px

    .ct-title
        font-size clamp(18px, 2.4vw, 28px)
        color #ffd27a
        letter-spacing 0.08em
        text-shadow 0 2px 8px rgba(0, 0, 0, 0.6)

    .ct-stage
        position relative
        flex 1
        width 100%
        min-height 0
        display flex
        align-items center
        justify-content center

    .ct-main
        height 100%
        max-width 100%
        display flex
        align-items center
        justify-content center
        padding 10px
        border-radius 6px
        background linear-gradient(135deg, #e8c25a, #a77a1c 50%, #f3d77a)
        box-shadow 0 10px 50px rgba(0, 0, 0, 0.7), inset 0 0 0 3px rgba(0, 0, 0, 0.3)

        img, video
            display block
            max-height calc(100% )
            max-width 100%
            object-fit contain
            background #000

    &:not(.is-video) .ct-video
        display none

    &.is-video .ct-photo
        display none

    .ct-nav
        position absolute
        top 50%
        transform translateY(-50%)
        width 52px
        height 52px
        border-radius 50%
        border 2px solid rgba(255, 210, 122, 0.7)
        background rgba(20, 10, 6, 0.6)
        color #ffd27a
        font-size 32px
        line-height 1
        cursor pointer

        &.ct-prev
            left 0
        &.ct-next
            right 0

    .ct-strip
        width 100%
        display flex
        gap 8px
        overflow-x auto
        padding 4px 2px 8px
        scrollbar-width thin

        button
            position relative
            flex 0 0 auto
            width 76px
            height 56px
            padding 0
            border 2px solid transparent
            border-radius 4px
            overflow hidden
            background #000
            cursor pointer
            opacity 0.65

            img
                width 100%
                height 100%
                object-fit cover

            span
                position absolute
                inset 0
                display flex
                align-items center
                justify-content center
                font-size 20px
                color #fff
                text-shadow 0 1px 4px #000

            &.is-active
                border-color #ffd27a
                opacity 1

    .ct-controls
        display flex
        gap 10px
        flex-wrap wrap
        justify-content center

        button
            padding 10px 18px
            border-radius 999px
            border 1px solid rgba(255, 210, 122, 0.6)
            background rgba(20, 10, 6, 0.55)
            color #fff2e8
            font-size 15px
            cursor pointer

        .ct-exit
            background #c30e3a
            border-color #ff8fa3
            font-weight 700

    @media (max-width 700px), (max-height 500px)
        .ct-curtain
            width 4vw
        .ct-inner
            margin 0 4vw
            padding 8px
            gap 6px
        .ct-strip button
            width 56px
            height 42px
        .ct-nav
            width 40px
            height 40px
            font-size 24px

@keyframes ct-in
    from
        opacity 0
        transform scale(1.03)
    to
        opacity 1
        transform none
