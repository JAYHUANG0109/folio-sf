// Napa castle: the 3D hall takes over the screen, this is only the overlay on top of it
.castle-theatre
    position fixed
    inset 0
    z-index 40
    display none
    pointer-events none
    color #fff2e8
    font-family "LXGW WenKai TC", "Noto Sans TC", "PingFang TC", sans-serif

    &.is-open
        display block
        animation ct-in 1.2s ease-out

    .ct-vignette
        position absolute
        inset 0
        background radial-gradient(ellipse at 50% 45%, transparent 55%, rgba(20, 8, 4, 0.65) 100%)

    .ct-title
        position absolute
        top 18px
        left 0
        right 0
        text-align center
        font-size clamp(18px, 2.4vw, 30px)
        color #ffd27a
        letter-spacing 0.08em
        text-shadow 0 2px 10px rgba(0, 0, 0, 0.8)

    .ct-count
        position absolute
        top 58px
        left 0
        right 0
        text-align center
        font-size 14px
        opacity 0.8
        text-shadow 0 1px 4px #000

    button
        pointer-events auto
        cursor pointer

    .ct-nav
        position absolute
        top 50%
        transform translateY(-50%)
        width 56px
        height 56px
        border-radius 50%
        border 2px solid rgba(255, 210, 122, 0.75)
        background rgba(20, 10, 6, 0.55)
        color #ffd27a
        font-size 34px
        line-height 1

        &.ct-prev
            left 20px
        &.ct-next
            right 20px

    .ct-controls
        position absolute
        bottom calc(20px + env(safe-area-inset-bottom))
        left 0
        right 0
        display flex
        gap 10px
        flex-wrap wrap
        justify-content center

        button
            padding 11px 20px
            border-radius 999px
            border 1px solid rgba(255, 210, 122, 0.6)
            background rgba(20, 10, 6, 0.6)
            color #fff2e8
            font-size 15px

        .ct-exit
            background #c30e3a
            border-color #ff8fa3
            font-weight 700

@keyframes ct-in
    from
        opacity 0
    to
        opacity 1

// nothing from the game HUD while touring the hall
html.is-in-castle
    .stop-card, .notifications, .guide, .js-guide, .menu-trigger, .map-trigger, .virtual-pad
        display none !important
